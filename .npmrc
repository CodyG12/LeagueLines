# @vite-pwa/astro's latest release (1.2.0) declares peer support only up to
# Astro ^5, but its actual build-time behavior (orchestrating service worker
# generation across Astro's SSR build) works correctly under Astro 7 — the
# stale peer range is a metadata lag, not a real incompatibility (see
# astro.config.mjs for the full explanation, including what IS broken).
# Without this, a plain `npm install` (e.g. Vercel's build step) fails with
# ERESOLVE on that peer conflict.
legacy-peer-deps=true
