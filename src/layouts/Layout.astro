---
import { ViewTransitions } from "astro:transitions";
import BottomNav from "../components/sub_components/BottomNav.astro";
import "../styles/global.css";

const isAdminRoute = Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={isAdminRoute ? "/leaguelines-icon-admin.svg" : "/leaguelines-icon.svg"}
    />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Erica+One&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&f[]=instrument-sans@400,500,600&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>LeagueLines</title>
    <ViewTransitions />
  </head>
  <body data-logged-in={Astro.locals.user ? "true" : "false"} class={isAdminRoute ? "" : "has-bottom-nav"}>
    <slot />
    {!isAdminRoute && <BottomNav />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
