---
import { ClientRouter } from "astro:transitions";
import BottomNav from "../components/sub_components/BottomNav.astro";
import InstallPromptBanner from "../components/sub_components/InstallPromptBanner.astro";
import IosInstallBanner from "../components/sub_components/IosInstallBanner.astro";
import "../styles/global.css";
import "../styles/trust-tokens.css";
import "../styles/social-tokens.css";

const isAdminRoute = Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={isAdminRoute ? "/leaguelines-icon-admin.svg" : "/leaguelines-icon.svg"}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href={isAdminRoute ? "/icon-192-admin.png" : "/icon-192.png"}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href={isAdminRoute ? "/icon-512-admin.png" : "/icon-512.png"}
    />
    <link
      rel="apple-touch-icon"
      href={isAdminRoute ? "/apple-touch-icon-admin.png" : "/apple-touch-icon.png"}
    />
    <link rel="shortcut icon" href={isAdminRoute ? "/favicon-admin.ico" : "/favicon.ico"} />
    {!isAdminRoute && <link rel="manifest" href="/manifest.webmanifest" />}
    <meta name="theme-color" content="#050506" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="LeagueLines" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Erica+One&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&f[]=instrument-sans@400,500,600&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>LeagueLines</title>
    <ClientRouter />
  </head>
  <body data-logged-in={Astro.locals.user ? "true" : "false"} class={isAdminRoute ? "" : "has-bottom-nav"}>
    <slot />
    {!isAdminRoute && <BottomNav />}
    {!isAdminRoute && <InstallPromptBanner />}
    {!isAdminRoute && <IosInstallBanner />}
    {!isAdminRoute && <script src="../scripts/registerSW.ts"></script>}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
