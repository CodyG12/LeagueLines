---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/sub_components/Nav.astro";
import Lightfall from "../components/react/Lightfall";
import { StandingsBoardIsland } from "../components/react/StandingsBoardIsland";
import { computeStandings, type Period } from "../lib/standings";

const periodParam = Astro.url.searchParams.get("period");
const period: Period = periodParam === "season" ? "season" : "week";
const { standings, upset, worstBeat } = await computeStandings(period);
---

<Layout>
  <div class="page-bg">
    <Lightfall client:load colors={["#d4a72c", "#7c5cfc"]} backgroundColor="#151417" />
  </div>
  <Nav showCategories={false} />
  <main class="container standings-wrap">
    <StandingsBoardIsland
      client:load
      period={period}
      standings={standings}
      upset={upset}
      worstBeat={worstBeat}
    />
  </main>
</Layout>

<style>
  .standings-wrap {
    text-align: left;
  }
</style>
