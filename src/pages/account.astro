---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/sub_components/Nav.astro";
import { Badges } from "../components/react/Badges";
import { SPRITE_AVATARS, isSpriteAvatar } from "../lib/sprites";
import { getBadgeDisplaysForUser } from "../lib/badges";

if (!Astro.locals.user) {
  return Astro.redirect("/login");
}

const user = Astro.locals.user;
const showSpritePicker = !user.avatarUrl || isSpriteAvatar(user.avatarUrl);
const badges = await getBadgeDisplaysForUser(user.id);
---

<Layout>
  <Nav showCategories={false} />
  <main class="container admin-login">
    <h2 class="title">Account</h2>
    <div class="card account-card">
      <img class="prop-avatar" src={user.avatarUrl ?? "/avatar-placeholder.svg"} alt="" loading="lazy" />
      <h1 class="player">{user.firstName} {user.lastName}</h1>
      <p class="time">@{user.username}</p>
      <p class="units-pill">{user.units} units</p>
      <form method="POST" action="/api/auth/logout" data-astro-reload>
        <button type="submit" class="btn-outline">Log Out</button>
      </form>
    </div>

    {
      showSpritePicker && (
        <div class="card sprite-picker-card">
          <p class="sprite-picker-label">Choose an avatar</p>
          <form method="POST" action="/api/account/avatar" class="sprite-picker-grid" data-astro-reload>
            {SPRITE_AVATARS.map((sprite) => (
              <button
                type="submit"
                name="avatarSprite"
                value={sprite}
                class={sprite === user.avatarUrl ? "sprite-option selected" : "sprite-option"}
                aria-label="Use this avatar"
              >
                <img src={sprite} alt="" loading="lazy" />
              </button>
            ))}
          </form>
        </div>
      )
    }

    <div class="card badges-card">
      <p class="sprite-picker-label">Badges</p>
      <Badges client:load badges={badges} />
    </div>
  </main>
</Layout>

<style>
  .badges-card {
    text-align: left;
  }
</style>
