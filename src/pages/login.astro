---
import Layout from "../layouts/Layout.astro";

const hasError = Astro.url.searchParams.has("error");
---

<Layout>
  <main class="container admin-login">
    <h2 class="title">Log In</h2>
    {hasError && <p class="form-error">Invalid username or password.</p>}
    <form method="POST" action="/api/auth/login" class="admin-form" data-astro-reload>
      <label for="username">Username</label>
      <input type="text" id="username" name="username" required autofocus />
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required />
      <button type="submit">Log In</button>
    </form>
    <p><a href="/signup">Need an account? Sign up</a></p>
  </main>
</Layout>
