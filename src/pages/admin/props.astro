---
import Layout from "../../layouts/Layout.astro";
import { listAllProps } from "../../lib/props";
import { listOptionSets, listStatOptionsBySport } from "../../lib/propOptions";
import { listAllUsers } from "../../lib/users";
import { sportIcon } from "../../lib/sportIcons";

const props = await listAllProps();
const { sport: sportOptions, player: playerOptions } = await listOptionSets();
const statOptionsBySport = await listStatOptionsBySport();
const users = await listAllUsers();
---

<Layout>
  <script src="../../scripts/adminProps.js"></script>
  <script src="../../scripts/profileCardTilt.js"></script>
  <main class="container admin-props">
    <div class="admin-header">
      <h2 class="title">
        <a href="/admin/props" class="site-brand nav-raise" data-astro-reload>Manage Player Props</a>
      </h2>
      <div class="admin-header-actions">
        <button type="button" id="seed-props-btn" class="secondary-btn"
          >Seed Random Props (Test)</button
        >
        <form method="POST" action="/api/admin/logout" data-astro-reload>
          <button type="submit">Log Out</button>
        </form>
      </div>
    </div>

    <form id="prop-form" class="admin-form">
      <h3 id="prop-form-title">New Prop</h3>
      <input type="hidden" id="prop-id" value="" />

      <div class="field">
        <div class="field-label-row">
          <label for="player">Player</label>
          <button type="button" class="manage-options-btn" data-option-type="player">Manage</button>
        </div>
        <select id="player" name="player" required>
          <option value="" disabled selected>Select player...</option>
          <optgroup label="Registered Users">
            {
              users.map((user) => (
                <option value={`user:${user.id}`}>
                  {user.firstName} {user.lastName} (@{user.username})
                </option>
              ))
            }
          </optgroup>
          <optgroup label="Other Players">
            {
              playerOptions.map((option) => (
                <option value={option}>{option}</option>
              ))
            }
          </optgroup>
          <option value="__add_new__">+ Add New...</option>
        </select>
      </div><div class="field">
        <div class="field-label-row">
          <label for="sport">Sport</label>
          <button type="button" class="manage-options-btn" data-option-type="sport">Manage</button>
        </div>
        <select id="sport" name="sport" required>
          <option value="" disabled selected>Select sport...</option>
          {
            sportOptions.map((option) => (
              <option value={option}>{option}</option>
            ))
          }
          <option value="__add_new__">+ Add New...</option>
        </select>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="team">Team (optional)</label>
          <input type="text" id="team" name="team" />
        </div>
        <div class="field">
          <div class="field-label-row">
            <label for="stat">Stat</label>
            <button type="button" class="manage-options-btn" data-option-type="stat">Manage</button>
          </div>
          <select id="stat" name="stat" required data-stat-options={JSON.stringify(statOptionsBySport)}>
            <option value="" disabled selected>Select a sport first...</option>
            <option value="__add_new__">+ Add New...</option>
          </select>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="line">Line</label>
          <input type="number" step="0.5" id="line" name="line" required />
        </div>
        <div class="field">
          <label for="startTime">Start Time</label>
          <input
            type="datetime-local"
            id="startTime"
            name="startTime"
            required
          />
        </div>
      </div>

      <div id="form-error" class="form-error"></div>
      <div class="admin-form-actions">
        <button type="button" id="prop-form-cancel" class="secondary-btn" hidden
          >Cancel Edit</button
        >
        <button type="submit" id="prop-form-submit">Create Prop</button>
      </div>
    </form>

    <div class="modal" id="manage-options-modal">
      <div class="modal-inner">
        <h2 id="manage-options-title">Manage Options</h2>
        <div id="manage-options-list"></div>
        <button type="button" id="manage-options-close" class="secondary-btn">Close</button>
      </div>
    </div>

    <div class="prop-grid">
      {
        props.map((prop) => (
          <div class="admin-prop" data-prop={JSON.stringify(prop)}>
            <div class="pc-card-wrapper">
              <div class="pc-card-shell">
                <section class="pc-card">
                  <div class="pc-inside">
                    <div class="pc-content pc-avatar-content">
                      <img
                        class="avatar"
                        src={prop.playerAvatarUrl}
                        alt=""
                        loading="lazy"
                      />
                      <div class="pc-bottom">
                        <div class="pc-user-info">
                          <div class="pc-sport-icon" title={prop.sport}>
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                              set:html={sportIcon(prop.sport)}
                            />
                          </div>
                          <div class="pc-handle">{prop.sport}</div>
                          <span
                            class={`status-pill status-pill--${prop.status}`}
                          >
                            {prop.status}
                          </span>
                        </div>
                      </div>
                    </div>
                    <div class="pc-content">
                      <div class="pc-details">
                        <h3>{prop.player}</h3>
                        <p>
                          {prop.line} {prop.stat}
                        </p>
                        {prop.team && <span class="pc-team">{prop.team}</span>}
                        <span class="pc-time">{prop.displayTime}</span>
                      </div>
                    </div>
                  </div>
                </section>
              </div>
            </div>

            <div class="pc-admin-panel">
              <div class="admin-prop-actions">
                <button type="button" class="edit-btn secondary-btn">
                  Edit
                </button>
                <button type="button" class="delete-btn">
                  Delete
                </button>
              </div>

              <form class="close-form">
                <select name="result" required>
                  <option value="" disabled selected>
                    Grade result...
                  </option>
                  <option value="over">Over</option>
                  <option value="under">Under</option>
                  <option value="push">Push</option>
                </select>
                <button type="submit" class="secondary-btn">
                  Close & Grade
                </button>
              </form>
            </div>
          </div>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .field-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .manage-options-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--secondary-text);
    text-decoration: underline;
    cursor: pointer;
  }

  .manage-options-btn:hover {
    color: var(--primary-text);
    background: none;
    transform: none;
  }

  #manage-options-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-height: 50vh;
    overflow-y: auto;
    margin: var(--space-4) 0;
    text-align: left;
  }

  .manage-option-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .manage-option-row .delete-btn {
    padding: var(--space-1) var(--space-3);
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .manage-options-empty {
    color: var(--secondary-text);
    font-size: 0.9rem;
    margin: var(--space-4) 0;
  }
</style>
