<div id="ios-install-banner" class="pwa-banner" role="status" hidden>
  <span class="pwa-banner-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 16V4M12 4l-3.5 3.5M12 4l3.5 3.5" />
      <path d="M5 12v6a2 2 0 002 2h10a2 2 0 002-2v-6" />
    </svg>
  </span>
  <div class="pwa-banner-text">
    <strong>Install LeagueLines</strong>
    <span>Tap <strong>Share</strong>, then "Add to Home Screen".</span>
  </div>
  <button type="button" id="ios-install-dismiss" class="pwa-banner-dismiss" aria-label="Dismiss">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>
</div>

<script src="../../scripts/iosInstallBanner.ts"></script>
