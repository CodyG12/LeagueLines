---
import GradientBlinds from "../react/GradientBlinds";
---

<div class="page-bg">
  <GradientBlinds
    client:load
    gradientColors={["#FF9FFC", "#5227FF"]}
    angle={20}
    noise={0.3}
    blindCount={16}
    blindMinWidth={60}
    spotlightRadius={0.5}
    spotlightSoftness={1}
    spotlightOpacity={0.6}
    mouseDampening={0.15}
    distortAmount={0}
    shineDirection="left"
    mixBlendMode="lighten"
  />
</div>
