---
---

<div id="pwa-install-banner" class="pwa-banner" role="status" hidden>
  <div class="pwa-banner-text">
    <strong>Install LeagueLines</strong>
    <span>Add it to your home screen for quick, app-like access.</span>
  </div>
  <div class="pwa-banner-actions">
    <button type="button" id="pwa-install-btn" class="pwa-banner-install-btn">Install</button>
    <button type="button" id="pwa-install-dismiss" class="pwa-banner-dismiss" aria-label="Dismiss">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<script src="../../scripts/installPrompt.ts"></script>
